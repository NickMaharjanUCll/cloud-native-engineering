        "@prisma/client": "^5.1.1",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^3.0.2",
        "body-parser": "^1.20.1",
        "cors": "^2.8.0",
        "date-fns": "^2.30.0",
        "dotenv": "^16.0.0",
        "express": "^4.21.1",
        "express-jwt": "^8.4.1",
        "functions_veso": "file:",
        "helmet": "^7.2.0",
        "jsonwebtoken": "^9.0.2",
        "redis": "^4.6.11",
        "swagger-jsdoc": "^6.2.0",
        "swagger-ui-express": "^4.6.0",
        "use-swr": "^1.0.3"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.0",
        "@types/bcryptjs": "^3.0.0",
        "@types/body-parser": "^1.19.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.13",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^20.17.31",
        "@types/redis": "^4.0.10",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "prisma": "^5.22.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.0",
        "typescript": "^4.9.5"
    }
