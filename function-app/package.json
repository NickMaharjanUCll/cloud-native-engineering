{
    "name": "functions_veso",
    "version": "1.0.0",
    "description": "Veso",
    "main": "dist/**/*.js",
    "license": "ISC",
    "prisma": {
        "schema": "repository/prisma/schema.prisma"
    },
    "scripts": {
        "test": "jest",
        "build": "tsc",
        "watch": "tsc -w",
        "clean": "rimraf dist",
        "prestart": "npm run clean && npm run build",
        "start": "func start --verbose"
    },
    "nodemonConfig": {
        "ext": "ts",
        "delay": "3",
        "execMap": {
